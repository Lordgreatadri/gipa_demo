APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The values above are HTTP-friendly local defaults. In production over HTTPS,
# set SESSION_ENCRYPT=true (encrypts the session payload at rest) and
# SESSION_SECURE_COOKIE=true (restricts the cookie to TLS connections).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Audit-log retention window in days (activitylog:clean runs daily via scheduler).
ACTIVITY_LOGGER_DELETE_OLDER_THAN_DAYS=365

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Required by DefaultSystemUserSeeder. Use unique secrets per environment.
DEFAULT_SYSTEM_USER_NAME=
DEFAULT_SYSTEM_USER_EMAIL=
DEFAULT_SYSTEM_USER_PASSWORD=

# Required by demo role and investor scenario seeders. Never commit populated credentials.
IOMP_SEED_DEMO_DATA=false
DEMO_STAFF_PASSWORD=
DEMO_INVESTOR_PASSWORD=
DEMO_INVESTOR_EMAIL_PATTERN=
DEMO_INVESTOR_COUNT=150
DEMO_SUPER_ADMIN_NAME=
DEMO_SUPER_ADMIN_EMAIL=
DEMO_CONTENT_MANAGER_NAME=
DEMO_CONTENT_MANAGER_EMAIL=
DEMO_DISTRICT_OFFICER_NAME=
DEMO_DISTRICT_OFFICER_EMAIL=
DEMO_FIELD_AGENT_NAME=
DEMO_FIELD_AGENT_EMAIL=
DEMO_REVIEWER_NAME=
DEMO_REVIEWER_EMAIL=
DEMO_INVESTOR_NAME=
DEMO_INVESTOR_EMAIL=

DISTRICT_REVIEW_SLA_HOURS=72
OPPORTUNITY_REVIEW_SLA_HOURS=72
INVESTOR_ONBOARDING_REVIEW_SLA_HOURS=72

# Certificate signing keys must be outside the repository and readable only by the signing process.
CERTIFICATE_ACTIVE_KEY_ID=iomp-mvp-1
CERTIFICATE_SIGNATURE_ALGORITHM=RSA-SHA256
CERTIFICATE_PRIVATE_KEY_PATH=
CERTIFICATE_PUBLIC_KEY_PATH=

# API access JWTs are short-lived. Refresh secrets are opaque, hashed at rest, rotated, and revocable.
# Use a unique high-entropy key per environment; do not reuse APP_KEY in production.
JWT_SIGNING_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

ASSISTANT_DRIVER=offline
ASSISTANT_NAME="GIPA Assistant"
ASSISTANT_TAGLINE="Ask about investment opportunities, sectors, districts and onboarding."
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=30

# --- SMS gateways -----------------------------------------------------------
# Provider credentials (Wigal Frog API key/username, Twilio SID/auth token),
# sender IDs and webhook signing secrets are NOT set here. The platform owner
# captures them at /staff/sms, where they are stored encrypted in the database.
# The settings below only control dispatch behaviour.
SMS_ENABLED=true
# ISO country dialling code used to normalise local numbers such as 0201234567.
SMS_DEFAULT_COUNTRY_CODE=233
SMS_QUEUE=sms
# Leave blank to use QUEUE_CONNECTION. Set to "redis" once a Redis server is available.
SMS_QUEUE_CONNECTION=
# Warn on the SMS dashboard when remaining bundle units or credit fall to this level.
SMS_LOW_BALANCE_THRESHOLD=100
# Per-gateway process logs are written to storage/logs/sms/.
SMS_LOG_LEVEL=debug
SMS_LOG_DAYS=30

# The babdev/laravel-twilio variables below are intentionally left empty: this
# platform reads Twilio credentials from the encrypted SMS configuration record,
# not from the environment.
TWILIO_API_SID=
TWILIO_API_AUTH_TOKEN=
TWILIO_API_FROM_NUMBER=

# --- Webhooks ---------------------------------------------------------------
# Secret for the generic spatie/laravel-webhook-client "default" endpoint.
# SMS delivery-report endpoints use per-provider secrets held in the database.
WEBHOOK_CLIENT_SECRET=

# --- Database backups -------------------------------------------------------
# Backups are written to the private "backups" disk (storage/app/backups).
# Set an archive password in production so dumps are encrypted at rest.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
# Fallback recipient for backup health notifications when the above is unset.
IOMP_ADMIN_EMAIL=

